# Данные о людях — лауреатах Нобелевской премии.
# Data about human Nobel Prize laureates.

SELECT DISTINCT
  ?laureate
  ?laureateLabel
  ?prize
  ?prizeLabel
  ?awardDate
  (YEAR(?awardDate) AS ?awardYear)
  ?citizenshipLabel
  ?genderLabel
  ?birthDate
  (YEAR(?birthDate) AS ?birthYear)
  ?occupationLabel
WHERE {
  VALUES ?prize {
    wd:Q38104   # Nobel Prize in Physics
    wd:Q44585   # Nobel Prize in Chemistry
    wd:Q80061   # Nobel Prize in Physiology or Medicine
    wd:Q37922   # Nobel Prize in Literature
    wd:Q47170   # Nobel Peace Prize
    wd:Q80068   # Nobel Memorial Prize in Economic Sciences
  }

  ?laureate wdt:P31 wd:Q5.
  ?laureate p:P166 ?awardStatement.
  ?awardStatement ps:P166 ?prize.
  OPTIONAL { ?awardStatement pq:P585 ?awardDate. }

  OPTIONAL { ?laureate wdt:P27 ?citizenship. }
  OPTIONAL { ?laureate wdt:P21 ?gender. }
  OPTIONAL { ?laureate wdt:P569 ?birthDate. }
  OPTIONAL { ?laureate wdt:P106 ?occupation. }

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "ru,en".
  }
}
ORDER BY ?awardYear ?prizeLabel ?laureateLabel